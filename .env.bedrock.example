PORT=8000
FORCE_REINDEX=1

# Provider selection
LLM_PROVIDER=bedrock
EMBEDDING_PROVIDER=bedrock

# Required
AWS_REGION=us-east-2
# Low-cost default recommendation for Bedrock chat.
# Verify the exact model ID in your account with:
# aws bedrock list-foundation-models --region us-east-2 --query 'modelSummaries[?providerName==`Amazon`].[modelId]' --output text
BEDROCK_CHAT_MODEL=amazon.nova-micro-v1:0
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0

# For Lightsail, set explicit AWS credentials unless you have configured
# another supported credential source on the host.
AWS_ACCESS_KEY_ID=replace_with_your_access_key
AWS_SECRET_ACCESS_KEY=replace_with_your_secret_key

# Retrieval tuning
RAG_BM25_WEIGHT=0.85
RAG_VECTOR_WEIGHT=0.15
RAG_RERANKER=auto
RAG_SUPPRESS_TOC=true

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_METHOD=POST
RATE_LIMIT_PATH=/
RATE_LIMIT_TRUST_PROXY=true

# Site controls
SITE_ENABLED=true
SITE_DISABLED_REPO_URL=https://github.com/your-org/your-repo
