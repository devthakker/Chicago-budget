PORT=8000
FORCE_REINDEX=1

# Provider selection
LLM_PROVIDER=bedrock
EMBEDDING_PROVIDER=bedrock

# Required
AWS_REGION=us-east-2
# Low-cost default recommendation for Bedrock chat.
# For Amazon Nova on Bedrock, use a SYSTEM_DEFINED inference profile ID or ARN,
# not the raw foundation-model ID. Find one with:
# aws bedrock list-inference-profiles --region us-east-2 --type-equals SYSTEM_DEFINED --query 'inferenceProfileSummaries[?contains(inferenceProfileName, `Nova Micro`) || contains(inferenceProfileId, `nova-micro`)].[inferenceProfileId,inferenceProfileArn]' --output table
BEDROCK_CHAT_MODEL=replace_with_nova_micro_inference_profile_id_or_arn
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0

# For Lightsail, set explicit AWS credentials unless you have configured
# another supported credential source on the host.
AWS_ACCESS_KEY_ID=replace_with_your_access_key
AWS_SECRET_ACCESS_KEY=replace_with_your_secret_key

# Retrieval tuning
RAG_BM25_WEIGHT=0.85
RAG_VECTOR_WEIGHT=0.15
RAG_RERANKER=auto
RAG_SUPPRESS_TOC=true

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_METHOD=POST
RATE_LIMIT_PATH=/
RATE_LIMIT_TRUST_PROXY=true

# Site controls
SITE_ENABLED=true
SITE_DISABLED_REPO_URL=https://github.com/your-org/your-repo
